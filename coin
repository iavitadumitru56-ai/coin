local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local CloneMenu = Players.LocalPlayer.PlayerGui.MenuGui:Clone()
CloneMenu.DisplayOrder = 0
CloneMenu.Name = "CloneMenu"

local ObjectsToRemove = {
	"Menu",
	"Back",
	"Bought",
	"Close",
	"Deselect",
	"Favorite",
	"Open",
	"Select",
	"Swap",
	"ToyTemplates",
	"UnFavorite",
	"View",
	"MenuAndToysNavigation",
}

for _, name in ipairs(ObjectsToRemove) do
	local obj = CloneMenu:FindFirstChild(name)
	if obj then
		obj:Destroy()
	end
end
CloneMenu.Parent = game:GetService("CoreGui") 


local original = Players.LocalPlayer.PlayerGui.MenuGui.TopRight

for _, obj in ipairs(original:GetDescendants()) do
	if obj:IsA("GuiObject") then
		obj.BackgroundTransparency = 1
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
		obj.TextTransparency = 1
	end

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		obj.ImageTransparency = 1
	end

	if obj:IsA("UIStroke") then
		obj.Transparency = 1
	end
end

original.BackgroundTransparency = 1


task.spawn(function()
    local player = Players.LocalPlayer

    local OriginalCoins = player.PlayerGui.MenuGui.TopRight.CoinsFrame.CoinsDisplay.Coins
    local CloneCoins = game:GetService("CoreGui").CloneMenu.TopRight.CoinsFrame.CoinsDisplay.Coins

    CloneCoins.TextColor3 = Color3.fromRGB(255, 255, 255)

    local flagGradient = CloneCoins:FindFirstChildOfClass("UIGradient")
    if not flagGradient then
        flagGradient = Instance.new("UIGradient")
        flagGradient.Name = "FlagGradient"
        flagGradient.Parent = CloneCoins
    end

    flagGradient.Rotation = 0


    flagGradient.Offset = Vector2.new(-0.8, 0)

    local moveTweenInfo = TweenInfo.new(
        2,                           
        Enum.EasingStyle.Sine,
        Enum.EasingDirection.InOut,
        -1,                          
        true                         
    )

    local moveTween = TweenService:Create(flagGradient, moveTweenInfo, {
        Offset = Vector2.new(0.8, 0)
    })
    moveTween:Play()


    local UkraineColors = {
        { Time = 0.00, Color = Color3.fromRGB(0, 87, 183) },
        { Time = 0.45, Color = Color3.fromRGB(0, 87, 183) },
        { Time = 0.55, Color = Color3.fromRGB(255, 215, 0) },
        { Time = 0.75, Color = Color3.fromRGB(255, 215, 0) },
        { Time = 1.00, Color = Color3.fromRGB(255, 215, 0) }
    }


    local RomaniaColors = {
        { Time = 0.00, Color = Color3.fromRGB(0, 43, 127) },
        { Time = 0.33, Color = Color3.fromRGB(0, 43, 127) },
        { Time = 0.50, Color = Color3.fromRGB(252, 209, 22) },
        { Time = 0.66, Color = Color3.fromRGB(252, 209, 22) },
        { Time = 1.00, Color = Color3.fromRGB(206, 17, 38) }
    }


    local function transitionFlag(fromColors, toColors, duration)
        local startTime = os.clock()
        while true do
            local elapsed = os.clock() - startTime
            local alpha = math.clamp(elapsed / duration, 0, 1)
            local t = math.sin((alpha * math.pi) / 2) 

            local keypoints = {}
            for i = 1, #fromColors do
                local c1 = fromColors[i].Color
                local c2 = toColors[i].Color
                local pos = fromColors[i].Time + (toColors[i].Time - fromColors[i].Time) * t

                local r = c1.R + (c2.R - c1.R) * t
                local g = c1.G + (c2.G - c1.G) * t
                local b = c1.B + (c2.B - c1.B) * t

                table.insert(keypoints, ColorSequenceKeypoint.new(pos, Color3.new(r, g, b)))
            end

            flagGradient.Color = ColorSequence.new(keypoints)

            if alpha >= 1 then break end
            RunService.RenderStepped:Wait()
        end
    end


    task.spawn(function()
        while true do

            transitionFlag(RomaniaColors, UkraineColors, 1.2)
            task.wait(2.5)


            transitionFlag(UkraineColors, RomaniaColors, 1.2)
            task.wait(2.5)
        end
    end)


    local framesCount = 0
    local currentFPS = 0

    RunService.RenderStepped:Connect(function()
        framesCount += 1
    end)

    task.spawn(function()
        while task.wait(1) do
            currentFPS = framesCount
            framesCount = 0

            local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            local coins = OriginalCoins.Text:gsub("%D", "")

            CloneCoins.Text = string.format(
                "FPS: %d\nPing: %d ms\nCoins: %s",
                currentFPS,
                ping,
                coins
            )
        end
    end)
end)
